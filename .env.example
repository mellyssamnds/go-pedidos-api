# ====================================================
# Configurações do Banco de Dados
# ====================================================

# Endereço do servidor do banco de dados
# Exemplo: localhost, 127.0.0.1 ou db.example.com
DB_HOST=localhost

# Porta do banco de dados
# Exemplo: 5432 (PostgreSQL), 3306 (MySQL)
# Porta 5433 para evitar conflito com instalações locais do Postgres na porta padrão 5432
DB_PORT=5432

# Usuário com permissão de acesso ao banco
DB_USER=seu_usuario

# Senha do usuário do banco
DB_PASSWORD=sua_senha

# Nome do banco de dados
DB_NAME=nome_do_banco